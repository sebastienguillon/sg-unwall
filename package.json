{
  "name": "tacet",
  "version": "2026.10.20",
  "private": true,
  "description": "A Manifest V3 browser extension that removes consent walls and other blocking popups, their overlays, and the scroll locks they leave behind.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:ext": "web-ext lint --source-dir src --warnings-as-errors",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run test && pnpm run lint:ext",
    "start:chrome": "web-ext run --source-dir src --target chromium",
    "start:firefox": "web-ext run --source-dir src",
    "probe": "node scripts/probe.mjs",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "site": "node scripts/site.mjs",
    "site:serve": "python3 -m http.server 8766 --bind 127.0.0.1 --directory docs",
    "package": "pnpm run check && web-ext build --source-dir src --artifacts-dir web-ext-artifacts --overwrite-dest --filename tacet-{version}.zip"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "web-ext": "^10.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
